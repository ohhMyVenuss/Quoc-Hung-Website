# Khóa bảo mật Django (bắt buộc đổi khóa ngẫu nhiên phức tạp trên Production)
DJANGO_SECRET_KEY=django-insecure-71jc*2#@_wamqyi!e(*-c@-k&qlyh@x=s913tyt875e6wy--+h

# Chế độ gỡ lỗi (True khi phát triển cục bộ, False khi triển khai Staging/Production)
DJANGO_DEBUG=True

# Danh sách host được phép truy cập (ngăn cách bởi dấu phẩy)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
